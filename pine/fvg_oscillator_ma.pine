// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// FVG Oscillator MA — Pine Script v6 port of the MT4 "FVG Oscillator MA".
// Core logic is ported from the open-source FVG_Oscillator.mq4 (Mario Jemic,
// Gehtsoft USA, GPL — fxcodebase topic 73871, archived in
// github.com/gehtsoft-usa/fxcodebase-backup):
//   * bullish FVG (low > high[2]): add the gap to Data if Data > 0, else restart at the gap;
//   * bearish FVG (high < low[2]): add the (negative) gap if Data < 0, else restart at it;
//   * no FVG: Data keeps its value (flat).
// Optional (on by default, not in MT4): only the still-unfilled part of each gap counts.
// The "MA" wrapper smooths Data with FvgPeriod/FvgMode. Its .ex4 is encrypted;
// expressing Data in points is inferred from the MT4 screenshot (HotLevel 50).
// Non-forex symbols (crypto, stocks) default to ATR units so values compare across assets.
// MT4-only UI inputs (clock, button, sound file, History) are not ported.

//@version=6
indicator("FVG Oscillator MA", shorttitle = "FVGOSCMA", overlay = false, precision = 2, max_boxes_count = 500)

// ───────── Inputs (names follow the MT4 dialog) ─────────
grpMain = "Oscillator"
tfInput    = input.timeframe("", "TimeFrame", group = grpMain, tooltip = "Empty = current chart timeframe.")
fvgPeriod  = input.int(21, "FvgPeriod", minval = 1, group = grpMain)
fvgMode    = input.string("Linear weighted", "FvgMode", options = ["Simple", "Exponential", "Smoothed", "Linear weighted"], group = grpMain)
sigPeriod  = input.int(0, "SigPeriod", minval = 0, group = grpMain, tooltip = "0 = no signal line.")
sigMode    = input.string("Linear weighted", "SigMode", options = ["Simple", "Exponential", "Smoothed", "Linear weighted"], group = grpMain)
hotLevel   = input.float(50.0, "HotLevel", minval = 0, group = grpMain)
units      = input.string("Auto", "Units", options = ["Auto", "Points", "Pips (10 points)", "ATR", "% of price", "Price"], group = grpMain, tooltip = "Unit of the accumulated gap size. Auto = Points on forex, ATR elsewhere (crypto, stocks). Points = MT4 Point (0.00001 on FX, 0.001 on JPY pairs).")
hotLevelN  = input.float(1.0, "HotLevel (ATR / %)", minval = 0, step = 0.1, group = grpMain, tooltip = "HotLevel used when the unit is ATR or % of price.")
atrLen     = input.int(14, "ATR length", minval = 1, group = grpMain)
resetFill  = input.bool(true, "Count only unfilled FVG parts", group = grpMain, tooltip = "Not in the MT4 original. Closes back inside a gap shrink it and a gap closed through drops out, so the oscillator is the size of the still-unfilled gaps. Turn off to match MT4.")
showIndex  = input.string("Standard Histogram", "ShowIndex", options = ["Standard Histogram", "Line"], group = grpMain)

grpArr = "Arrows & alerts"
drawArrows = input.string("on Indicator & Chart", "DrawArrows", options = ["off", "on Indicator", "on Chart", "on Indicator & Chart"], group = grpArr)
arrowOn    = input.string("Zero cross", "Arrow trigger", options = ["Zero cross", "HotLevel cross", "Signal cross", "Slope change"], group = grpArr)
deadZone   = input.float(20.0, "Signal dead zone (% of HotLevel)", minval = 0, step = 5, group = grpArr, tooltip = "Zero-cross arrows need the oscillator to move beyond ± this share of HotLevel, so tiny wiggles around zero give no signal. 0 = plain zero cross.")
alertBar   = input.int(1, "ALERTBAR", minval = 0, maxval = 1, group = grpArr, tooltip = "1 = closed bar (no repaint), 0 = live bar.")
startTime  = input.string("00:00", "StartTime", group = grpArr)
endTime    = input.string("23:59", "EndTime", group = grpArr)

grpBox = "FVG boxes"
showBoxes = input.bool(true, "Show FVG boxes on chart", group = grpBox, tooltip = "Draws every detected FVG on the price chart and extends it until price fills the gap; filled boxes stop and fade. Only when TimeFrame is the chart timeframe.")
hideFilled = input.bool(true, "Hide filled boxes", group = grpBox, tooltip = "Delete a box once price fills the gap, so only still-valid FVGs stay on the chart.")
minBoxAtr  = input.float(0.0, "Min box size (× ATR)", minval = 0, step = 0.05, group = grpBox, tooltip = "Skip boxes for gaps smaller than this multiple of ATR (e.g. 0.2). 0 = draw all. Affects only the boxes, not the oscillator.")

grpCol = "Colors"
colorBuy  = input.color(#00ff7f, "ColorBUY", group = grpCol)    // SpringGreen
colorSell = input.color(#ff69b4, "ColorSELL", group = grpCol)   // HotPink
colorSig  = input.color(#ffd700, "Signal", group = grpCol)

// ───────── Calculation ─────────
maOf(float src, int len, string mode) =>
    switch mode
        "Simple"      => ta.sma(src, len)
        "Exponential" => ta.ema(src, len)
        "Smoothed"    => ta.rma(src, len)
        => ta.wma(src, len)

// MT4 Point on a 5-digit FX feed; TradingView feeds such as ICE quote only 4 digits.
mt4Point = syminfo.type == "forex" ? (syminfo.currency == "JPY" ? 0.001 : 0.00001) : syminfo.mintick
unit = units == "Auto" ? (syminfo.type == "forex" ? "Points" : "ATR") : units
hot  = unit == "ATR" or unit == "% of price" ? hotLevelN : hotLevel

fvgOsc() =>
    // Unfilled gaps of the current run (all bullish or all bearish).
    var int dir  = 0
    var gapTop   = array.new<float>()
    var gapBot   = array.new<float>()
    if low > high[2]                             // bullish FVG
        if dir != 1
            dir := 1
            gapTop.clear()
            gapBot.clear()
        gapTop.push(low)
        gapBot.push(high[2])
    if high < low[2]                             // bearish FVG
        if dir != -1
            dir := -1
            gapTop.clear()
            gapBot.clear()
        gapTop.push(low[2])
        gapBot.push(high)
    // Mitigation: closes back inside a gap shrink it; a gap closed through is gone.
    if resetFill and gapTop.size() > 0
        for i = gapTop.size() - 1 to 0
            if dir == 1
                gapTop.set(i, math.min(gapTop.get(i), close))
            else
                gapBot.set(i, math.max(gapBot.get(i), close))
            if gapTop.get(i) <= gapBot.get(i)
                gapTop.remove(i)
                gapBot.remove(i)
    if gapTop.size() > 500
        gapTop.shift()
        gapBot.shift()
    data = dir * (nz(gapTop.sum()) - nz(gapBot.sum()))
    atr = ta.atr(atrLen)
    unitSize = switch unit
        "Points"           => mt4Point
        "Pips (10 points)" => mt4Point * 10
        "ATR"              => atr
        "% of price"       => close / 100
        => 1.0
    maOf(data / unitSize, fvgPeriod, fvgMode)

osc = request.security(syminfo.tickerid, tfInput, fvgOsc(), lookahead = barmerge.lookahead_off)
sig = sigPeriod > 0 ? maOf(osc, sigPeriod, sigMode) : na

// ───────── Plots ─────────
oscColor = osc >= 0 ? colorBuy : colorSell
isHist   = showIndex == "Standard Histogram"
plot(isHist ? osc : na, "FVG Histogram", color = oscColor, style = plot.style_columns)
plot(isHist ? na : osc, "FVG Line",      color = oscColor, linewidth = 2)
plot(sig, "Signal", color = colorSig, linewidth = 1)
plot(hot,  "Hot +", color = colorBuy,  linestyle = plot.linestyle_dotted)
hline(0,         "Zero",  color = color.gray,               linestyle = hline.style_dashed)
plot(-hot, "Hot -", color = colorSell, linestyle = plot.linestyle_dotted)

// ───────── Signals ─────────
ref = arrowOn == "Signal cross" and sigPeriod > 0 ? sig : arrowOn == "HotLevel cross" ? hot : 0.0
refDn = arrowOn == "HotLevel cross" ? -hot : ref
slope = osc - osc[1]

// Zero cross with hysteresis: the side flips only once osc leaves the dead zone.
dz = hot * deadZone / 100
var int side = 0
prevSide = side
side := osc > dz ? 1 : osc < -dz ? -1 : side
zeroBuy  = side == 1 and prevSide != 1
zeroSell = side == -1 and prevSide != -1

rawBuy  = arrowOn == "Slope change" ? slope > 0 and nz(slope[1]) <= 0 : arrowOn == "Zero cross" ? zeroBuy  : ta.crossover(osc, ref)
rawSell = arrowOn == "Slope change" ? slope < 0 and nz(slope[1]) >= 0 : arrowOn == "Zero cross" ? zeroSell : ta.crossunder(osc, refDn)

inSession = not na(time(timeframe.period, str.replace(startTime, ":", "") + "-" + str.replace(endTime, ":", "") + ":1234567"))
confirmed = alertBar == 1 ? barstate.isconfirmed : true
buy  = rawBuy  and inSession
sell = rawSell and inSession

onInd   = drawArrows == "on Indicator" or drawArrows == "on Indicator & Chart"
onChart = drawArrows == "on Chart" or drawArrows == "on Indicator & Chart"
plotshape(onInd and buy,    "BUY (ind)",    shape.triangleup,   location.bottom,   colorBuy,  size = size.tiny)
plotshape(onInd and sell,   "SELL (ind)",   shape.triangledown, location.top,      colorSell, size = size.tiny)
plotshape(onChart and buy,  "BUY (chart)",  shape.triangleup,   location.belowbar, colorBuy,  size = size.small, force_overlay = true)
plotshape(onChart and sell, "SELL (chart)", shape.triangledown, location.abovebar, colorSell, size = size.small, force_overlay = true)

// ───────── FVG boxes (chart timeframe) ─────────
// Open boxes extend right until price trades through the far side of the gap.
var array<box> openBull = array.new<box>()
var array<box> openBear = array.new<box>()

updateBoxes(array<box> boxes, bool isBull, color col) =>
    if boxes.size() > 0
        for i = boxes.size() - 1 to 0
            b = boxes.get(i)
            filled = isBull ? low <= b.get_bottom() : high >= b.get_top()
            b.set_right(bar_index)
            if filled
                if hideFilled
                    b.delete()
                else
                    b.set_bgcolor(color.new(col, 93))
                    b.set_border_color(color.new(col, 75))
                boxes.remove(i)

minBox = minBoxAtr * ta.atr(atrLen)

if showBoxes and tfInput == ""
    updateBoxes(openBull, true, colorBuy)
    updateBoxes(openBear, false, colorSell)
    if barstate.isconfirmed
        if low > high[2] and low - high[2] >= minBox
            openBull.push(box.new(bar_index - 2, low, bar_index, high[2], border_color = color.new(colorBuy, 40), bgcolor = color.new(colorBuy, 80), force_overlay = true))
        if high < low[2] and low[2] - high >= minBox
            openBear.push(box.new(bar_index - 2, low[2], bar_index, high, border_color = color.new(colorSell, 40), bgcolor = color.new(colorSell, 80), force_overlay = true))
        if openBull.size() > 150
            openBull.shift()
        if openBear.size() > 150
            openBear.shift()

// ───────── Alerts ─────────
alertcondition(buy,  "FVGOSCMA BUY",  "FVG Osc MA AL ▲ {{ticker}} {{interval}} @ {{close}}")
alertcondition(sell, "FVGOSCMA SELL", "FVG Osc MA SAT ▼ {{ticker}} {{interval}} @ {{close}}")

alertMsg(string signal) =>
    signal + " " + syminfo.ticker + " " + timeframe.period + " @ " + str.tostring(close, format.mintick) +
     " | osc " + str.tostring(osc, "#.##")

// "Any alert() function call" alert; ALERTBAR = 1 fires only on closed bars.
if buy and confirmed
    alert(alertMsg("FVG Osc MA AL ▲"), alertBar == 1 ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
if sell and confirmed
    alert(alertMsg("FVG Osc MA SAT ▼"), alertBar == 1 ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
